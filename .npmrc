# Font Awesome Pro is no longer required: the app uses the free
# @fortawesome/free-solid-svg-icons set (public npm), so the @fortawesome
# scope resolves from the default public npm registry.
#
# To restore Font Awesome Pro icons, set FONTAWESOME_NPM_AUTH_TOKEN and
# uncomment the two lines below:
# @fortawesome:registry=https://npm.fontawesome.com/
# //npm.fontawesome.com/:_authToken=${FONTAWESOME_NPM_AUTH_TOKEN}
